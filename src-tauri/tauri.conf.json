{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EquiPar",
  "version": "1.0.0",
  "identifier": "cl.uandes.equipar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "width": 1280,
        "height": 768
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
      "enable": true,
      "scope": ["$HOME/**", "/home/**", "/tmp/**", "**"]
    }
    }
  },
  "bundle": {
    "resources": ["resources/**/*"],
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Escuela de Kinesiología-Universidad de los Andes"
  }
}
